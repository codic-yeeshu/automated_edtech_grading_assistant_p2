# DL Grading Assistant — environment overrides
# Copy to .env and edit as needed. All fields are optional.

FLASK_ENV=development

# HuggingFace model checkpoints (change to local paths for offline use)
TROCR_CHECKPOINT=microsoft/trocr-base-handwritten
SBERT_CHECKPOINT=all-mpnet-base-v2
CROSS_ENC_CHECKPOINT=cross-encoder/stsb-roberta-base
